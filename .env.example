# Copy to .env (next to deploy/compose.yml usage: --env-file .env) and fill in. Never commit real secrets.

# Public address
LEARNING_PUBLIC_ORIGIN=https://learn.example.org
LEARNING_SITE_ADDRESS=learn.example.org
LEARNING_SECURE_COOKIES=true

# Database
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Media storage: local (Docker volume) or s3
LEARNING_STORAGE_MODE=local
# LEARNING_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# LEARNING_S3_REGION=eu-central-1
# LEARNING_S3_BUCKET=learning-media
# LEARNING_S3_ACCESS_KEY=
# LEARNING_S3_SECRET_KEY=
# LEARNING_S3_PATH_STYLE=false
# LEARNING_MEDIA_ORIGIN=https://learning-media.s3.eu-central-1.amazonaws.com

# Email (optional; without it use temporary passwords and assisted resets)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# LEARNING_MAIL_FROM=Learning Portal <no-reply@example.org>
